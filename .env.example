# Optional: send the forms somewhere other than the site's own api/submit.ts.
VITE_ENQUIRY_ENDPOINT=

# The Sanity project the site reads its news, gallery, events, testimonials and training
# results from (edited in studio/). Both are public. Without a project id the site shows the
# copy bundled in src/data instead.
VITE_SANITY_PROJECT_ID=qj6pcnnt
VITE_SANITY_DATASET=production

# Server-only (never VITE_-prefixed): an Editor token from sanity.io/manage -> API -> Tokens,
# which api/submit.ts uses to save form submissions. Set it in Vercel's environment variables too.
SANITY_WRITE_TOKEN=
